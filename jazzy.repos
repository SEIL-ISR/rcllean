# Everything rcllean needs from source, into deps/:
#   vcs import deps < jazzy.repos
#
# rosidl_lean generates the Lean bindings; the rcl_interfaces packages carry
# none as binaries, so they are built here.  unique_identifier_msgs is what
# action_msgs from that repository needs.
repositories:
  rosidl_lean:
    type: git
    url: https://github.com/SEIL-ISR/rosidl_lean.git
    version: main
  common_interfaces:
    type: git
    url: https://github.com/ros2/common_interfaces.git
    version: jazzy
  rcl_interfaces:
    type: git
    url: https://github.com/ros2/rcl_interfaces.git
    version: jazzy
  test_interface_files:
    type: git
    url: https://github.com/ros2/test_interface_files.git
    version: jazzy
  unique_identifier_msgs:
    type: git
    url: https://github.com/ros2/unique_identifier_msgs.git
    version: jazzy
  rosidl_core:
    type: git
    url: https://github.com/ros2/rosidl_core.git
    version: jazzy
  rosidl_defaults:
    type: git
    url: https://github.com/ros2/rosidl_defaults.git
    version: jazzy
